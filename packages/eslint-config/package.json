{
  "name": "@monholm/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monholm/mono-repo.git",
    "directory": "packages/eslint-config"
  },
  "type": "module",
  "exports": {
    ".": "./dist/configs/base.js",
    "./node": "./dist/configs/node.js",
    "./react": "./dist/configs/react.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc",
    "lint": "eslint . --max-warnings 0",
    "format-check": "prettier . --check --cache-location=_unused",
    "format": "prettier . --write --cache-location=_unused"
  },
  "peerDependencies": {
    "@eslint/js": ">= 9.35.0",
    "@stylistic/eslint-plugin": ">= 5.6.1",
    "eslint": ">= 9.35.0",
    "eslint-plugin-import": ">= 2.32.0",
    "eslint-plugin-n": ">= 17.23.1",
    "eslint-plugin-react": ">= 7.37.5",
    "eslint-plugin-react-hooks": ">= 6.1.1",
    "typescript": ">= 5.8.0",
    "typescript-eslint": ">= 8.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-n": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@monholm/prettier-config": "workspace:*",
    "@monholm/tsconfig": "workspace:*",
    "@stylistic/eslint-plugin": "5.8.0",
    "eslint": "9.39.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.23.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "6.1.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0"
  }
}
